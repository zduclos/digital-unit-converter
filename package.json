{
  "name": "digital-unit-converter",
  "version": "1.1.0",
  "description": "Utility to simplify conversion of digital units of measurement",
  "author": "Zach Duclos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zduclos/digital-unit-converter.git"
  },
  "bugs": {
    "url": "https://github.com/zduclos/digital-unit-converter/issues"
  },
  "homepage": "https://github.com/zduclos/digital-unit-converter#readme",
  "keywords": [
    "convert",
    "converter",
    "unit",
    "units",
    "digital",
    "data",
    "storage",
    "size",
    "measurement",
    "si",
    "iec",
    "binary",
    "decimal",
    "bit",
    "byte",
    "kilobyte",
    "kibibyte",
    "megabyte",
    "mebibyte",
    "gigabyte",
    "gibibyte",
    "terabyte",
    "tebibyte"
  ],
  "type": "commonjs",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib/**/*"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js"
    }
  },
  "scripts": {
    "watch": "tsc --watch & nodemon -q -w lib lib/index.js",
    "build": "tsc",
    "clean": "rm -rf lib node_modules coverage",
    "test": "jest",
    "lint": "eslint 'src/**/*.ts' --quiet",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^30.0.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0"
  }
}
