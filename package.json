{
  "name": "digital-unit-converter",
  "version": "1.1.0",
  "description": "Utility to simplify conversion of digital units of measurement",
  "author": "Zach Duclos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zduclos/digital-unit-converter.git"
  },
  "bugs": {
    "url": "https://github.com/zduclos/digital-unit-converter/issues"
  },
  "homepage": "https://github.com/zduclos/digital-unit-converter#readme",
  "keywords": [
    "convert",
    "converter",
    "unit",
    "units",
    "digital",
    "data",
    "storage",
    "size",
    "measurement",
    "si",
    "iec",
    "binary",
    "decimal",
    "bit",
    "byte",
    "kilobyte",
    "kibibyte",
    "megabyte",
    "mebibyte",
    "gigabyte",
    "gibibyte",
    "terabyte",
    "tebibyte"
  ],
  "type": "commonjs",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib/**/*",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf lib coverage",
    "test": "jest",
    "lint": "eslint 'src/**/*.ts' --quiet",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "check": "npm run lint && npm run format:check && npm test",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
